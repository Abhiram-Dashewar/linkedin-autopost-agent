      "parameters": {
        "jsCode": "const item = $input.first();\nif (item.binary && item.binary.data) {\n  return [{ json: { imageReady: true }, binary: { data: item.binary.data } }];\n}\nconst res = item.json || {};\nconst b64 = (res.result && res.result.image) || res.image;\nif (!b64) {\n  throw new Error('Cloudflare returned no image. Response: ' + JSON.stringify(res).slice(0, 500));\n}\nconst bin = await this.helpers.prepareBinaryData(Buffer.from(b64, 'base64'), 'post-image.jpg', 'image/jpeg');\nreturn [{ json: { imageReady: true }, binary: { data: bin } }];"
      },
